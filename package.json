{
  "name": "xuetangsha",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "学堂杀 · 九科争鸣 —— v2.1 技能创意重设计（20 名学科名人机制改写：免疫/转移/距离陷阱/装备失效/马政），构建产出单 HTML 文件",
  "scripts": {
    "dev": "node scripts/dev.mjs cdn",
    "dev:bundled": "node scripts/dev.mjs bundled",
    "build": "npm run build:cdn && npm run build:bundled",
    "build:cdn": "node scripts/build.mjs cdn",
    "build:bundled": "node scripts/build.mjs bundled",
    "build:banks": "node scripts/build-banks.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "audit:banks": "node scripts/audit-banks.mjs",
    "audit:expansion": "node scripts/build-expansion.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:skills": "node scripts/smoke-skills.mjs",
    "smoke:net": "node scripts/smoke-net.mjs",
    "smoke:net:settle": "node scripts/smoke-net-settle.mjs",
    "smoke:tiesuo": "node scripts/smoke-tiesuo.mjs",
    "repro:net": "node scripts/repro-net.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:lazy": "node scripts/verify-lazy.mjs",
    "verify:file": "node scripts/verify-file.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
