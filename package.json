{
  "name": "xuetangsha",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "学堂杀 · 九科争鸣 —— TypeScript 工程化重构，构建产出单 HTML 文件",
  "scripts": {
    "dev": "node scripts/dev.mjs cdn",
    "dev:bundled": "node scripts/dev.mjs bundled",
    "build": "npm run build:cdn && npm run build:bundled",
    "build:cdn": "node scripts/build.mjs cdn",
    "build:bundled": "node scripts/build.mjs bundled",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
